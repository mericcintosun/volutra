# Volutra needs no secret. There is no API key, database or server credential.
# All analysis (spiral unwrap, FFT, logistic regression) runs in the visitor's browser
# and every reading is stored in localStorage. lib/config.ts is the only module that reads
# process.env.

# fake = seed stand-ins, real = converted UCI 395 recordings; set by the farm runner
ADAPTER_MODE=fake

# Filled by next.config.ts at build time from public/brand/*.png. Leave empty.
NEXT_PUBLIC_BRAND_FILES=
